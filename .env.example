# ===============================================
# RestockAI Environment Configuration
# ===============================================

# App Environment (development / production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Connection (PostgreSQL)
# PostgreSQL: postgresql://restock_user:restock_password@localhost:5432/restockai
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restockai

# Email / SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
EMAIL_FROM=noreply@restockai.io
FRONTEND_URL=http://localhost:5173

# Anthropic Claude API Key (Optional for live LLM reasoning; fallback heuristic is active by default)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_CACHE_ENABLED=true

# Google Sheets Integration (Path to Service Account JSON key)
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json

# Security & Authentication
JWT_SECRET_KEY=replace_with_a_secure_random_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Port Configuration
API_PORT=8000
FRONTEND_PORT=5173
